// Version resource shared by the DLL and qsysver.exe.
// Compile with /DQPH_DESCRIPTION="..." /DQPH_FILENAME="..." (see build.cmd).
#include <winres.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    QPH_VERSION_MAJOR, QPH_VERSION_MINOR, QPH_VERSION_PATCH, 0
 PRODUCTVERSION QPH_VERSION_MAJOR, QPH_VERSION_MINOR, QPH_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       QPH_FILETYPE
 FILESUBTYPE    0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      QPH_PUBLISHER
            VALUE "FileDescription",  QPH_DESCRIPTION
            VALUE "FileVersion",      QPH_VERSION_STR
            VALUE "InternalName",     QPH_FILENAME
            VALUE "LegalCopyright",   QPH_COPYRIGHT
            VALUE "OriginalFilename", QPH_FILENAME
            VALUE "ProductName",      "Q-SYS Design Property Handler"
            VALUE "ProductVersion",   QPH_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
